# Application Settings
PROJECT_NAME="DocMind AI Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
SECRET_KEY="replace-this-with-a-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & Reverse Proxy Security
# Set to "true" only if running behind a trusted reverse proxy (e.g. Nginx, Cloudflare, AWS ALB)
# Keep "false" when running directly exposed or in development to prevent X-Forwarded-For spoofing
TRUST_PROXY_HEADERS="false"

# Database
DATABASE_URL="sqlite:///./data/docmind.db"

# ChromaDB Vector Database Storage Directory
CHROMADB_DIR="./data/chromadb"

# OpenAI API (For text-embedding-3-large & ChatGPT models like gpt-4o)
OPENAI_API_KEY="your-openai-api-key-here"
DEFAULT_EMBEDDING_MODEL="text-embedding-3-large"

# Google Gemini API (For Gemini models like gemini-1.5-flash)
GEMINI_API_KEY="your-gemini-api-key-here"

# Ollama / Llama Configuration (Local Llama 3 instance)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLAMA_MODEL="llama3"
